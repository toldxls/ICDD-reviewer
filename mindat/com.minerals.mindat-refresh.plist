<?xml version="1.0" encoding="UTF-8"?>
<!--
  Monthly refresh of the Mindat IMA/group cache (mindat/mindat.py --refresh).
  Runs on the 1st of each month at 09:00 — roughly the CNMNC newsletter cadence.

  NOTE: replace /ABSOLUTE/PATH/TO/review_tool below with the real path on your
  machine before installing (LaunchAgents require absolute paths).

  Enable:
    cp "/ABSOLUTE/PATH/TO/review_tool/mindat/com.minerals.mindat-refresh.plist" ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.minerals.mindat-refresh.plist
  Run once now to test:
    launchctl start com.minerals.mindat-refresh
  Disable:
    launchctl unload ~/Library/LaunchAgents/com.minerals.mindat-refresh.plist
  Logs: review_tool/.cache/refresh.log  (and refresh.err)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minerals.mindat-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.12/bin/python3</string>
        <string>/ABSOLUTE/PATH/TO/review_tool/mindat/mindat.py</string>
        <string>--refresh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/review_tool</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key><integer>1</integer>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/review_tool/.cache/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/review_tool/.cache/refresh.err</string>
</dict>
</plist>
