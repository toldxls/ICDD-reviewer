#!/usr/bin/env python3
"""Dev launcher for running the tools straight from a checkout WITHOUT installing.
After `pip install -e .` you get a real `pxrd` on PATH and can drop the `./`.

    ./pxrd gui [folder]   ./pxrd review [folder]   ./pxrd check [fixtures]   …

All it does is put the repo on sys.path so `pxrd_review` imports, then hand off to
the real CLI (pxrd_review/cli.py)."""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from pxrd_review.cli import main
main()
